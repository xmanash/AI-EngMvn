OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Optional; defaults to "default" when unset.
PINECONE_NAMESPACE=default
# Must match the Pinecone index dimension; 1024 is used by default.
OPENAI_EMBEDDING_DIMENSIONS=1024
# Optional ingestion configuration; defaults are 800 and 100.
INGEST_CHUNK_SIZE=800
INGEST_CHUNK_OVERLAP=100
